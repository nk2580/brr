{
  "name": "brr",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "runtime:build": "node scripts/build-runtime.mjs",
    "runtime:test": "cargo +stable test --manifest-path runtime/codex/brr/policy/Cargo.toml",
    "runtime:smoke": "node scripts/smoke-runtime.mjs",
    "runtime:helper-smoke": "node scripts/smoke-code-host.mjs",
    "native:smoke": "cargo test --manifest-path src-tauri/Cargo.toml connects_to_owned_runtime -- --ignored",
    "test:build-tools": "node --test scripts/runtime-artifacts.test.mjs",
    "desktop:dev": "pnpm runtime:build && pnpm tauri dev",
    "desktop:build": "pnpm runtime:build --release && pnpm tauri build --config src-tauri/tauri.bundle.conf.json",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
