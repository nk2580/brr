ARG BASE_IMAGE=debian:12-slim
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils dbus dbus-user-session systemd systemd-sysv python3 ca-certificates dpkg-dev file passwd procps util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY verify-install.sh /usr/local/sbin/brr-verify-install
RUN chmod 0755 /usr/local/sbin/brr-verify-install
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
