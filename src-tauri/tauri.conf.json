{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brr",
  "version": "0.1.0",
  "identifier": "dev.brr.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Brr", "width": 1280, "height": 860, "minWidth": 800, "minHeight": 600, "titleBarStyle": "Overlay", "hiddenTitle": true, "backgroundColor": "#212121" }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; frame-src 'self' http://127.0.0.1:*" }
  },
  "bundle": { "active": true, "targets": ["app"], "shortDescription": "Your local coding workspace", "category": "DeveloperTool", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
